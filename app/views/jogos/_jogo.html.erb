  <p class="local">
    <strong>Local:</strong>
    <%= jogo.local %>
  </p>
  
  <div id="<%= dom_id jogo %>" class="container">
  
  <p class="item">
    <% if jogo.clube_mandante %>
      <%= jogo.clube_mandante&.nome %>
    <% else %>
      Não tem clube mandante
    <% end %>
  </p>

  <p class="item">
    <%= jogo.placar_mandante %>
    <strong> x </strong>
  </p>

  <p class="item">
    <%= jogo.placar_visitante %>
  </p>

  <p class="item">
    <%= jogo.clube_visitante&.nome || "Não tem clube mandante" %>
  </p>
</div>